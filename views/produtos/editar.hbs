<h1>{{title}}</h1>

{{! Formulário que carrega os dados atuais do objeto produto }}
<form action="/produtos/{{produto.id}}/editar" method="POST" class="form-container">
    <div class="campo-form">
        <label for="titulo">
            Título do Produto:
        </label>
        <input type="text" id="titulo" name="titulo" value="{{produto.titulo}}" required />
    </div>

    <div class="campo-form">
        <label for="preco">Preço (R$):</label>
        <input type="number" id="preco" name="preco" step="0.01" min="0" value="{{produto.preco}}" required />
    </div>

    <div class="campo-form">
        <label for="quantidade">Quantidade</label>
        <input type="number" id="quantidade" name="quantidade" min="0" value="{{produto.quantidade}}" required />
    </div>

    <div class="campo-form">
        <label for="status">Status:</label>
        <select id="status" name="status">
            <option value="Disponível">Disponível</option>
            <option value="Esgotado">Esgotado</option>
            <option value="Inativo">Inativo</option>
        </select>
    </div>

    <div class="botoes-form">
        <button type="submit" class="btn btn-principal">
            Atualizar Produto
        </button>
        <a href="/produtos" class="btn btn-cancelar">
            Cancelar
        </a>
    </div>

</form>